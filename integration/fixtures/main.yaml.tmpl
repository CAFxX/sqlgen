# Generated by integration/fixtures (gen.go) from main.yaml.tmpl: edit the template, then `make gen`.
# Engine flavor <%.Flavor%>: the statements are the same for every engine except the RETURNING ones.
package: <%.Pkg%>
out: <%.Pkg%>_gen.go
dialect: <%.Dialect%>

statements:
  - name: InsertItems
    kind: exec
    sql: |
      INSERT INTO sg_items (id, org_id, name, score, status)
      VALUES :rows:[]NewItem(ID:int64 ASC, OrgID:int64, Name:string, Score:int64, Status:string)

  - name: GetItem
    kind: one
    result_type: Item
    sql: |
      SELECT id:int64, org_id:int64, name:string, score:int64, status:string
      FROM sg_items
      WHERE id = :id:int64

  - name: ItemsByIDs
    kind: many
    result_type: Item
    sql: |
      SELECT id:int64, org_id:int64, name:string, score:int64, status:string
      FROM sg_items
      WHERE id IN (:ids:[]int64 ASC)
      ORDER BY id

  - name: SearchItems
    kind: many
    result_type: Item
    sql: |
      SELECT id:int64, org_id:int64, name:string, score:int64, status:string
      FROM sg_items
      WHERE score >= :min_score:int64
        {?FilterOrg: AND org_id = :org_id:int64}
        {?FilterStatuses: AND status IN (:statuses:[]string)}
        {?FilterNamePrefix: AND name LIKE :name_like:string}
      ORDER BY id

  - name: PageItems
    kind: many
    result_type: PagedItem
    args: struct
    sql: |
      SELECT id:int64, org_id:int64, name:string, score:int64, status:string
      FROM sg_items
      WHERE org_id = :org_id:int64
        AND :After:sqlgen.Seek
      ORDER BY :Sort:sqlgen.Order(score, id)
      LIMIT :limit:int64

  # Widest sqlgen.Order the generator accepts (runtime.MaxOrderCols): every column is sortable.
  - name: WideRows
    kind: many
    result_type: Wide
    args: struct
    sql: |
      SELECT c1:int64, c2:int64, c3:int64, c4:int64, c5:int64, c6:int64, c7:int64, c8:int64, c9:int64, c10:int64, c11:int64, id:int64
      FROM sg_wide
      WHERE :After:sqlgen.Seek
      ORDER BY :Sort:sqlgen.Order(c1,c2,c3,c4,c5,c6,c7,c8,c9,c10,c11, id)
      LIMIT :limit:int64

  - name: AddScore
    kind: exec
    sql: |
      UPDATE sg_items SET score = score + :delta:int64
      WHERE id IN (:ids:[]int64 ASC) AND org_id = :org_id:int64

  - name: AddScoreOne
    kind: exec
    sql: |
      UPDATE sg_items SET score = score + :delta:int64 WHERE id = :id:int64

  - name: DeleteItems
    kind: exec
    sql: |
      DELETE FROM sg_items WHERE id IN (:ids:[]int64 ASC)

  - name: TopOrgs
    kind: subquery
    sql: |
      SELECT org_id FROM sg_items GROUP BY org_id HAVING COUNT(*) >= :min_items:int64

  - name: OrgStats
    kind: many
    result_type: OrgStat
    sql: |
      WITH picked AS (:orgs:sqlgen.Query)
      SELECT i.org_id:int64, COUNT(*) AS n:int64, COALESCE(SUM(i.score), 0) AS total:int64
      FROM sg_items i
      WHERE i.org_id IN (SELECT org_id FROM picked) AND i.status = :status:string
      GROUP BY i.org_id
      ORDER BY i.org_id

  - name: InsertItem
    kind: exec
    sql: |
      INSERT INTO sg_items (id, org_id, name, score, status)
      VALUES (:id:int64, :org_id:int64, :name:string, :score:int64, :status:string)

  - name: SetAllStatus
    kind: exec
    sql: |
      UPDATE sg_items SET status = :status:string

<%- if eq .Flavor "pg" %>

  # ---- PostgreSQL-protocol only (RETURNING on writes, explicit ::type casts in tuples) ----
  - name: UpsertItemsReturning
    kind: many
    result_type: Written
    sql: |
      INSERT INTO sg_items (id, org_id, name, score, status)
      VALUES :rows:[]NewItem(ID:int64::bigint ASC, OrgID:int64::bigint, Name:string::text, Score:int64::bigint, Status:string::text)
      ON CONFLICT (id) DO UPDATE SET score = sg_items.score + EXCLUDED.score
      RETURNING id:int64, score:int64

  - name: BumpScoresReturning
    kind: many
    result_type: Written
    sql: |
      UPDATE sg_items SET score = score + :delta:int64
      WHERE id IN (:ids:[]int64 ASC)
      RETURNING id:int64, score:int64

  - name: DeleteReturning
    kind: many
    result_type: Written
    sql: |
      DELETE FROM sg_items WHERE id IN (:ids:[]int64 DESC)
      RETURNING id:int64, score:int64

<%- else if eq .Flavor "mariadb" %>

  # ---- MariaDB only: RETURNING on INSERT and DELETE (MariaDB has no UPDATE ... RETURNING) ----
  - name: InsertItemReturning
    kind: one
    result_type: Written
    sql: |
      INSERT INTO sg_items (id, org_id, name, score, status)
      VALUES (:id:int64, :org_id:int64, :name:string, :score:int64, :status:string)
      RETURNING id:int64, score:int64

  - name: InsertItemsReturning
    kind: many
    result_type: Written
    sql: |
      INSERT INTO sg_items (id, org_id, name, score, status)
      VALUES :rows:[]NewItem(ID:int64 ASC, OrgID:int64, Name:string, Score:int64, Status:string)
      RETURNING id:int64, score:int64

  - name: DeleteReturning
    kind: many
    result_type: Written
    sql: |
      DELETE FROM sg_items WHERE id IN (:ids:[]int64 DESC)
      RETURNING id:int64, score:int64

  - name: DeleteOneReturning
    kind: one
    result_type: Written
    sql: |
      DELETE FROM sg_items WHERE id = :id:int64
      RETURNING id:int64, score:int64

<%- end %>

  # ---- single output column and no result_type: the value itself is returned ----
  - name: CountOrgItems
    kind: one
    sql: SELECT COUNT(*) AS n:int64 FROM sg_items WHERE org_id = :org_id:int64

  - name: NamesByIDs
    kind: many
    sql: SELECT name:string FROM sg_items WHERE id IN (:ids:[]int64 ASC) ORDER BY id

  # ---- value forwarding between pipeline operations (wire_forward_test.go) ----
  - name: FwdScoreOf
    kind: one
    sql: SELECT score AS fwd:int64 FROM sg_items WHERE id = :id:int64

  - name: FwdIDsByStatus
    kind: one
    sql: SELECT id:int64 FROM sg_items WHERE status = :status:string ORDER BY id

  - name: FwdSetScore
    kind: exec
    sql: UPDATE sg_items SET score = :score:Arg[int64] WHERE id = :id:Arg[int64]

  - name: FwdInsertItem
    kind: exec
    sql: |
      INSERT INTO sg_items (id, org_id, name, score, status)
      VALUES (:id:Arg[int64], 1, :name:string, :score:Arg[int64], 'fwd')

  - name: FwdItemsAbove
    kind: many
    sql: SELECT id:int64 FROM sg_items WHERE score > :min:Arg[int64] ORDER BY id

  # one producer per forwarded type, one consumer for all of them (TestRealEngineForwardTypeFidelity)
  - name: FwdSrcI8
    kind: one
    sql: SELECT i8 AS v:int64 FROM sg_fwd_src WHERE k = :k:string
  - name: FwdSrcI8N
    kind: one
    sql: SELECT i8n AS v:*int64 FROM sg_fwd_src WHERE k = :k:string
  - name: FwdSrcS
    kind: one
    sql: SELECT s AS v:string FROM sg_fwd_src WHERE k = :k:string
  - name: FwdSrcTS
    kind: one
    sql: SELECT ts AS v:time.Time FROM sg_fwd_src WHERE k = :k:string
  - name: FwdSrcTSL
    kind: one
    sql: SELECT tsl AS v:time.Time FROM sg_fwd_src WHERE k = :k:string
  - name: FwdSrcB
    kind: one
    sql: SELECT b AS v:[]byte FROM sg_fwd_src WHERE k = :k:string
  - name: FwdSrcBo
    kind: one
    sql: SELECT bo AS v:bool FROM sg_fwd_src WHERE k = :k:string
  - name: FwdSrcF8
    kind: one
    sql: SELECT f8 AS v:float64 FROM sg_fwd_src WHERE k = :k:string
  - name: FwdSrcU
    kind: one
    sql: SELECT u AS v:string FROM sg_fwd_src WHERE k = :k:string
<%- if eq .Flavor "pg" %>
  - name: FwdDst
    kind: exec
    sql: |
      INSERT INTO sg_fwd_dst (k, i8, i8n, s, ts, tsl, b, bo, f8, u)
      VALUES (:k:string, :i8:Arg[int64], :i8n:Arg[*int64], :s:Arg[string]::text, :ts:Arg[time.Time], :tsl:Arg[time.Time]::timestamp,
        :b:Arg[[]byte], :bo:Arg[bool], :f8:Arg[float64], :u:Arg[string]::uuid)
<%- else %>
  - name: FwdDst
    kind: exec
    sql: |
      INSERT INTO sg_fwd_dst (k, i8, i8n, s, ts, tsl, b, bo, f8, u)
      VALUES (:k:string, :i8:Arg[int64], :i8n:Arg[*int64], :s:Arg[string], :ts:Arg[time.Time], :tsl:Arg[time.Time],
        :b:Arg[[]byte], :bo:Arg[bool], :f8:Arg[float64], :u:Arg[string])

  # AUTO_INCREMENT ids forwarded with LastInsertIDArg (MySQL family)
  - name: FwdAutoInsert
    kind: exec
    sql: INSERT INTO sg_fwd_auto (v) VALUES (:v:int64)
  - name: FwdAutoInsertIgnore
    kind: exec
    sql: INSERT IGNORE INTO sg_fwd_auto (id, v) VALUES (:id:int64, :v:int64)
  - name: FwdAutoInsertTwo
    kind: exec
    sql: INSERT INTO sg_fwd_auto (v) VALUES (:a:int64), (:b:int64)
<%- end %>
<%- if or (eq .Flavor "pg") (eq .Flavor "mariadb") %>

  - name: FwdInsertReturningID
    kind: one
    sql: |
      INSERT INTO sg_items (id, org_id, name, score, status)
      VALUES (:id:int64, :org_id:int64, :name:string, 0, 'new')
      RETURNING id AS new_id:int64
<%- end %>

<%- if or (eq .Flavor "pg") (eq .Flavor "mariadb") %>

  - name: InsertedIDs
    kind: many
    sql: |
      INSERT INTO sg_items (id, org_id, name, score, status)
      VALUES :rows:[]NewItem(ID:int64 ASC, OrgID:int64, Name:string, Score:int64, Status:string)
      RETURNING id:int64

<%- end %>
<%- if eq .Flavor "pg" %>

  # An empty VALUES list that feeds a CTE, not an INSERT, is not a no-op: ErrEmptySliceParam.
  - name: ApplyDeltas
    kind: exec
    sql: |
      WITH v(id, delta) AS (VALUES :rows:[]ScoreDelta(ID:int64::bigint ASC, Delta:int64::bigint))
      UPDATE sg_items SET score = score + v.delta FROM v WHERE sg_items.id = v.id
<%- end %>
