package integration

<%- if .BumpReturning %>

import (
	"context"

	"github.com/CAFxX/sqlgen/integration/<%.Pkg%>"
)

// BumpRet is UPDATE ... RETURNING, which MySQL and MariaDB do not have: their fixture (fzmy) has no such
// statement and reports it as unsupported.
func (a *<%.Pkg%>API) BumpRet(ctx context.Context, delta int64, ids []int64, grp *int64) ([]fzOut, error) {
	p := <%.Pkg%>.FzBumpRetParams{Delta: delta, IDs: ids}
	if grp != nil {
		p.OnlyGrp, p.Grp = true, *grp
	}
	return outs<%.Title%>(a.q.FzBumpRet(ctx, p))
}
<%- else %>

import (
	"context"
	"errors"
)

var errNoUpdateReturning = errors.New("UPDATE ... RETURNING is not supported by MySQL/MariaDB")

// BumpRet: no UPDATE ... RETURNING on MySQL or MariaDB, so the <%.Pkg%> package does not have the statement.
func (a *<%.Pkg%>API) BumpRet(context.Context, int64, []int64, *int64) ([]fzOut, error) {
	return nil, errNoUpdateReturning
}
<%- end %>
